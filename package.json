{
  "name": "egent",
  "version": "0.6.6",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm desktop:prepare && electron apps/desktop",
    "desktop:prepare": "pnpm build:packages && node scripts/build-desktop.mjs",
    "desktop:package": "pnpm build",
    "desktop:verify-icons": "node scripts/verify-icons.mjs",
    "desktop:verify-mcp": "node scripts/verify-mcp.mjs",
    "prepare:packages": "pnpm db:generate && pnpm --filter @egent/shared build && pnpm --filter @egent/database build",
    "build:packages": "pnpm db:generate && pnpm -r build",
    "build": "pnpm desktop:prepare && electron-builder --config electron-builder.yml --win --x64 --publish never && pnpm desktop:verify-icons",
    "typecheck": "pnpm prepare:packages && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @egent/database generate",
    "db:validate": "pnpm --filter @egent/database validate",
    "db:check": "pnpm --filter @egent/database check",
    "db:migrate": "pnpm --filter @egent/database migrate",
    "test": "pnpm prepare:packages && pnpm --filter @egent/server build && pnpm --filter @egent/server test && node --test apps/desktop/test/*.test.cjs",
    "test:codex:real": "pnpm --filter @egent/server exec tsx test/codex-real.ts",
    "start:server": "pnpm --filter @egent/server start",
    "test:smoke": "pnpm --filter @egent/shared build && pnpm --filter @egent/server test:smoke"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "24.13.4",
    "concurrently": "10.0.5",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "zod": "^4.6.7"
  }
}
