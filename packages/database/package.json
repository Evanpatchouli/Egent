{
  "name": "@egent/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --strict --skipLibCheck prisma.config.ts",
    "generate": "prisma generate",
    "validate": "prisma validate",
    "check": "tsx src/check.ts",
    "migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@libsql/client": "0.17.0",
    "@prisma/adapter-libsql": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "tsx": "4.23.13"
  }
}
